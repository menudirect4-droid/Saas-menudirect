# ====================================================
# Configuration des clés d'API IA — MenuDirect SaaS
# ====================================================
# Le système fonctionne par défaut de manière 100% autonome grâce
# à son moteur culinaire IA local spécialisé (gastronomie béninoise & internationale).
#
# Pour connecter des modèles de pointe en ligne (optionnel) :

# Clé API Google Gemini (Recommandé - Ultra rapide & support multilingue naturel)
# Obtenez votre clé gratuite sur : https://aistudio.google.com
GEMINI_API_KEY=votre_cle_gemini_ici

# Clé API OpenAI (Alternative GPT-4o / GPT-4o-mini)
# Obtenez votre clé sur : https://platform.openai.com
# OPENAI_API_KEY=sk-...

PORT=3000
